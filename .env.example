# ─────────────── App ───────────────
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
LOG_LEVEL=debug

# ─────────────── URLs (CORS + links) ───────────────
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173

# ─────────────── Database ───────────────
MONGODB_URI=mongodb://127.0.0.1:27017/iron_gym

# ─────────────── Auth / JWT ───────────────
JWT_SECRET=change_me_access_secret_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN=1h

# ─────────────── Cloudinary ───────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_ROOT=iron-gym

# ─────────────── Business rules ───────────────
EXPIRING_SOON_THRESHOLD_DAYS=7
DUPLICATE_CHECKIN_WINDOW_SECONDS=120
MEMBER_CODE_PREFIX=IRON

# ─────────────── Rate limiting ───────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ─────────────── Seed ───────────────
SEED_DEFAULT_PASSWORD=Passw0rd!2024
